# ============================================================
#  AgentSquad Workspace — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your keys.
# If ALL keys are left blank, the app runs in Demo/Simulation mode.

# --- OpenAI (Dots agent) ---
OPENAI_API_KEY=

# --- xAI / Grok ---
XAI_API_KEY=

# --- News APIs (optional — falls back to free RSS if omitted) ---
NEWS_API_KEY=

# --- Tavily (optional web-search for Muse agent) ---
TAVILY_API_KEY=

# --- Server ---
HOST=0.0.0.0
PORT=8500

